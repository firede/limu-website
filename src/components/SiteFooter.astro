---
import FooterNav from './FooterNav.astro';
import { localeOf, ui } from '../lib/i18n';
import { repositoryUrl, rustRepositoryUrl } from '../lib/site';

// The note is text and links in turn, the links to the Rust and Go repositories and to Pele,
// in the order the language writes them.
const note = ui[localeOf(Astro.url.pathname)].footerNote;
const hrefs = [rustRepositoryUrl, repositoryUrl, 'https://pele.run'];
---

<footer class="site-footer">
  <FooterNav />
  <p class="footer-note">{note.map((part, i) => (i % 2 === 1 ? <a href={hrefs[(i - 1) / 2]} target="_blank" rel="noopener noreferrer">{part}</a> : part))}</p>
</footer>
